@model IEnumerable<MenuComidaMVC.Models.ProductoComida>

@{
    ViewData["Title"] = "FALLOUT - Nuevo Pedido";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: radial-gradient(circle at top, rgba(53, 78, 35, 0.35), transparent 40%), #070a07;
        color: #d7ff8f;
        font-family: Consolas, "Courier New", monospace;
        min-height: 100vh;
    }

    .pantalla {
        width: 100%;
        min-height: 100vh;
        padding: 20px;
    }

    .encabezado {
        border: 3px solid #d8b837;
        background: rgba(12, 20, 12, 0.95);
        box-shadow: 0 0 18px rgba(216, 184, 55, 0.55);
        padding: 18px 24px;
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .marca h1 {
        margin: 0;
        color: #f0ce4e;
        font-size: 40px;
        letter-spacing: 4px;
        text-shadow: 0 0 12px rgba(240, 206, 78, 0.7);
    }

    .marca p {
        margin: 8px 0 0;
        font-size: 17px;
        color: #9dff77;
        letter-spacing: 2px;
    }

    .navegacion a {
        display: inline-block;
        margin-left: 10px;
        padding: 8px 14px;
        border: 2px solid #637d32;
        color: #d7ff8f;
        text-decoration: none;
        font-size: 14px;
        letter-spacing: 1px;
        background: rgba(18, 27, 18, 0.9);
    }

        .navegacion a:hover {
            border-color: #f0ce4e;
            color: #f0ce4e;
        }

    .alerta {
        border: 2px solid #ff5f5f;
        background: rgba(40, 10, 10, 0.85);
        color: #ffb3b3;
        padding: 12px 18px;
        margin-bottom: 18px;
        letter-spacing: 1px;
    }

    .contenido-pedido {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        align-items: start;
    }

    .cuadricula {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .tarjeta {
        background: rgba(18, 27, 18, 0.96);
        border: 2px solid #637d32;
        overflow: hidden;
        box-shadow: 0 0 12px rgba(99, 125, 50, 0.35);
    }

        .tarjeta img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            display: block;
            filter: saturate(0.9) contrast(1.05);
        }

    .info {
        padding: 12px;
        text-align: center;
    }

    .nombre {
        margin: 0 0 8px;
        color: #f0ce4e;
        font-size: 18px;
        min-height: 44px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .precio {
        color: #9dff77;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .selector-cantidad {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

        .selector-cantidad button {
            width: 32px;
            height: 32px;
            background: #1b2a10;
            border: 2px solid #637d32;
            color: #d7ff8f;
            font-size: 18px;
            cursor: pointer;
        }

            .selector-cantidad button:hover {
                border-color: #f0ce4e;
                color: #f0ce4e;
            }

        .selector-cantidad span {
            min-width: 24px;
            font-size: 18px;
            font-weight: bold;
        }

    .carrito {
        border: 3px solid #d8b837;
        background: rgba(12, 20, 12, 0.95);
        box-shadow: 0 0 18px rgba(216, 184, 55, 0.4);
        padding: 20px;
        position: sticky;
        top: 20px;
    }

        .carrito h2 {
            margin-top: 0;
            color: #f0ce4e;
            letter-spacing: 2px;
            font-size: 20px;
            border-bottom: 1px solid #637d32;
            padding-bottom: 10px;
        }

        .carrito label {
            display: block;
            margin-bottom: 6px;
            color: #9dff77;
            font-size: 14px;
        }

        .carrito input[type="text"] {
            width: 100%;
            padding: 10px;
            background: #0c140c;
            border: 2px solid #637d32;
            color: #d7ff8f;
            font-family: inherit;
            font-size: 15px;
            margin-bottom: 12px;
        }

    /* ESTILOS RECOMENDACIONES PIP-BOY */
    .caja-recomendaciones {
        border: 1px dashed #d8b837;
        background: rgba(20, 25, 12, 0.8);
        padding: 10px;
        margin-bottom: 16px;
    }

    .titulo-recomendaciones {
        color: #d8b837;
        font-size: 12px;
        margin: 0 0 8px 0;
        letter-spacing: 1px;
    }

    .btn-rec {
        background: #0c140c;
        border: 1px solid #9dff77;
        color: #9dff77;
        font-family: inherit;
        font-size: 12px;
        padding: 5px 8px;
        margin: 3px 2px;
        cursor: pointer;
        display: inline-block;
        transition: all 0.2s ease;
    }

        .btn-rec:hover {
            background: #9dff77;
            color: #0c140c;
            box-shadow: 0 0 8px rgba(157, 255, 119, 0.6);
        }

    #resumenCarrito {
        min-height: 40px;
        margin-bottom: 12px;
        border-top: 1px dashed #637d32;
        padding-top: 10px;
    }

    .fila-resumen {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        padding: 4px 0;
    }

    .vacio-carrito {
        color: #6b7a5e;
        font-size: 14px;
        text-align: center;
        padding: 10px 0;
    }

    .total-carrito {
        display: flex;
        justify-content: space-between;
        font-size: 20px;
        font-weight: bold;
        color: #f0ce4e;
        border-top: 1px solid #637d32;
        padding-top: 10px;
        margin-bottom: 16px;
    }

    #btnConfirmar {
        width: 100%;
        padding: 14px;
        background: #1b2a10;
        border: 2px solid #9dff77;
        color: #9dff77;
        font-family: inherit;
        font-size: 16px;
        letter-spacing: 2px;
        cursor: pointer;
    }

        #btnConfirmar:hover:not(:disabled) {
            background: #9dff77;
            color: #0c140c;
        }

        #btnConfirmar:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    @@media (max-width: 900px) {
        .contenido-pedido {
            grid-template-columns: 1fr;
        }

        .carrito {
            position: static;
        }
    }
</style>

<div class="pantalla">

    <header class="encabezado">
        <div class="marca">
            <h1>☢ FALLOUT ☢</h1>
            <p>ARMA TU PEDIDO</p>
        </div>

        <div style="border: 1px dashed #f0ce4e; padding: 8px 16px; background: #070a07; font-size: 0.9rem;">
            <span style="color: #f0ce4e; font-weight: bold; display: block;">👤 HABITANTE ACTIVO:</span>
            <span style="color: #9dff77;">@ViewBag.UsuarioNombre</span>
            <span style="color: #d8b837;">| @ViewBag.UsuarioRefugio</span>
        </div>

        <nav class="navegacion">
            <a asp-controller="Menu" asp-action="Index">MENÚ</a>
            <a asp-controller="Pedido" asp-action="Lista">PEDIDOS</a>
            <a asp-controller="Pedido" asp-action="Login" style="border-color: #ff5f5f; color: #ff5f5f;">SALIR</a>
        </nav>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="alerta">@TempData["Error"]</div>
    }

    <div class="contenido-pedido">
        <main id="menu-pedido" class="cuadricula"></main>

        <aside class="carrito">
            <h2>TU PEDIDO</h2>

            <form id="formPedido" asp-controller="Pedido" asp-action="Crear" method="post">
                <label for="nombreCliente">Nombre del cliente</label>
                <input type="text" id="nombreCliente" name="nombreCliente" value="@ViewBag.UsuarioActual" readonly style="opacity: 0.8;" />

                <!-- CONTENEDOR DE RECOMENDACIONES -->
                <div id="contenedor-recomendaciones" class="caja-recomendaciones" style="display: none;">
                    <p class="titulo-recomendaciones">⚠️ SUGERENCIAS DE HISTORIAL:</p>
                    <div id="lista-recomendaciones"></div>
                </div>

                <div id="resumenCarrito">
                    <div class="vacio-carrito">Aún no has seleccionado productos.</div>
                </div>

                <div class="total-carrito">
                    <span>Total</span>
                    <span id="totalCarrito">$0.00</span>
                </div>

                <button type="submit" id="btnConfirmar" disabled>Confirmar pedido</button>
            </form>
        </aside>
    </div>

</div>

<script>
    let productos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
    let cantidades = productos.map(() => 0);

    function renderizarProductos() {
        const contenedor = document.getElementById("menu-pedido");
        contenedor.innerHTML = "";

        productos.forEach(function (producto, indice) {
            const tarjeta = document.createElement("article");
            tarjeta.className = "tarjeta";

            // Normalización de la ruta de la imagen
            let rutaImagen = producto.Imagen || '';
            if (rutaImagen.startsWith('~')) {
                rutaImagen = rutaImagen.substring(1);
            }

            tarjeta.innerHTML = `
                <img src="${rutaImagen}" alt="${producto.Nombre}" />
                <div class="info">
                    <h2 class="nombre">${producto.Nombre}</h2>
                    <div class="precio">$${Number(producto.Precio).toFixed(2)}</div>
                    <div class="selector-cantidad">
                        <button type="button" onclick="cambiarCantidad(${indice}, -1)">-</button>
                        <span id="cantidad-${indice}">${cantidades[indice]}</span>
                        <button type="button" onclick="cambiarCantidad(${indice}, 1)">+</button>
                    </div>
                </div>
            `;

            contenedor.appendChild(tarjeta);
        });
    }

    function cambiarCantidad(indice, delta) {
        cantidades[indice] = Math.max(0, cantidades[indice] + delta);
        document.getElementById(`cantidad-${indice}`).textContent = cantidades[indice];
        actualizarCarrito();
    }

    function actualizarCarrito() {
        const resumen = document.getElementById("resumenCarrito");
        const totalSpan = document.getElementById("totalCarrito");
        const boton = document.getElementById("btnConfirmar");

        let total = 0;
        let filas = "";

        productos.forEach(function (producto, indice) {
            const cantidad = cantidades[indice];

            if (cantidad > 0) {
                const subtotal = producto.Precio * cantidad;
                total += subtotal;

                filas += `
                    <div class="fila-resumen">
                        <span>${producto.Nombre} x${cantidad}</span>
                        <span>$${subtotal.toFixed(2)}</span>
                    </div>
                `;
            }
        });

        resumen.innerHTML = filas || '<div class="vacio-carrito">Aún no has seleccionado productos.</div>';
        totalSpan.textContent = `$${total.toFixed(2)}`;
        boton.disabled = total <= 0;
    }

    document.getElementById("formPedido").addEventListener("submit", function () {
        const form = this;

        productos.forEach(function (producto, indice) {
            const cantidad = cantidades[indice];

            if (cantidad > 0) {
                agregarOculto(form, "nombres", producto.Nombre);
                agregarOculto(form, "precios", producto.Precio);
                agregarOculto(form, "cantidades", cantidad);
            }
        });
    });

    function agregarOculto(form, nombreCampo, valor) {
        const input = document.createElement("input");
        input.type = "hidden";
        input.name = nombreCampo;
        input.value = valor;
        form.appendChild(input);
    }

    function cargarRecomendacionesCliente() {
        const contenedor = document.getElementById('contenedor-recomendaciones');
        const lista = document.getElementById('lista-recomendaciones');
        const nombreSolo = "@ViewBag.UsuarioNombre";

        if (!nombreSolo || nombreSolo.length < 2) {
            if (contenedor) contenedor.style.display = 'none';
            return;
        }

        fetch(`/Pedido/ObtenerRecomendaciones?nombreCliente=${encodeURIComponent(nombreSolo)}`)
            .then(res => res.json())
            .then(data => {
                lista.innerHTML = '';

                if (data && data.length > 0) {
                    contenedor.style.display = 'block';

                    data.forEach(item => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn-rec';
                        btn.innerText = `+ ${item.nombre} ($${item.precio})`;

                        btn.onclick = function () {
                            agregarRecomendacion(item.nombre);
                        };

                        lista.appendChild(btn);
                    });
                } else {
                    contenedor.style.display = 'none';
                }
            })
            .catch(err => console.error('Error al cargar recomendaciones:', err));
    }

    function agregarRecomendacion(nombreProducto) {
        const indice = productos.findIndex(p => p.Nombre.toLowerCase() === nombreProducto.toLowerCase());
        if (indice !== -1) {
            cambiarCantidad(indice, 1);
        }
    }

    renderizarProductos();
    actualizarCarrito();
    cargarRecomendacionesCliente();
</script>

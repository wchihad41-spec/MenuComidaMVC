@{
    ViewData["Title"] = "FALLOUT - Acceso";
    Layout = null; // Para que no cargue barras de navegación ni fondos externos
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>FALLOUT - Identificación de Habitante</title>
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                background: radial-gradient(circle at center, rgba(53, 78, 35, 0.4), transparent 60%), #070a07;
                color: #d7ff8f;
                font-family: Consolas, "Courier New", monospace;
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .caja-login {
                background: rgba(12, 20, 12, 0.98);
                border: 3px solid #d8b837;
                box-shadow: 0 0 25px rgba(216, 184, 55, 0.5);
                padding: 35px;
                width: 100%;
                max-width: 420px;
                text-align: center;
            }

                .caja-login h1 {
                    color: #f0ce4e;
                    font-size: 24px;
                    margin: 0 0 10px 0;
                    letter-spacing: 2px;
                    text-shadow: 0 0 10px rgba(240, 206, 78, 0.6);
                }

                .caja-login p {
                    color: #9dff77;
                    font-size: 13px;
                    margin-bottom: 25px;
                }

            .campo {
                margin-bottom: 18px;
                text-align: left;
            }

                .campo label {
                    display: block;
                    color: #9dff77;
                    font-size: 13px;
                    margin-bottom: 6px;
                }

                .campo input {
                    width: 100%;
                    padding: 10px;
                    background: #070a07;
                    border: 2px solid #637d32;
                    color: #f0ce4e;
                    font-family: inherit;
                    font-size: 15px;
                }

                    .campo input:focus {
                        outline: none;
                        border-color: #f0ce4e;
                    }

            .btn-ingresar {
                width: 100%;
                padding: 12px;
                background: #1b2a10;
                border: 2px solid #9dff77;
                color: #9dff77;
                font-family: inherit;
                font-size: 15px;
                letter-spacing: 2px;
                cursor: pointer;
                margin-top: 10px;
                transition: all 0.2s ease;
            }

                .btn-ingresar:hover {
                    background: #9dff77;
                    color: #0c140c;
                    box-shadow: 0 0 12px rgba(157, 255, 119, 0.6);
                }
    </style>
</head>
<body>

    <div class="caja-login">
        <h1>☢ ACCESO AL REFUGIO ☢</h1>
        <p>Ingresa tus datos para habilitar la terminal de suministros.</p>

        <form asp-controller="Pedido" asp-action="Login" method="post">
            <div class="campo">
                <label for="nombreCliente">Nombre completo:</label>
                <input type="text" id="nombreCliente" name="nombreCliente" required placeholder="Ej. Juan Pérez" autocomplete="off" />
            </div>

            <div class="campo">
                <label for="refugio">Número de Refugio / ID:</label>
                <input type="text" id="refugio" name="refugio" placeholder="Ej. Refugio 101" autocomplete="off" />
            </div>

            <button type="submit" class="btn-ingresar">INGRESAR A LA TERMINAL</button>
        </form>
    </div>

</body>
</html>